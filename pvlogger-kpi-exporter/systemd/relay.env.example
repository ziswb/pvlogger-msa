# /etc/pvlogger-relay/relay.env — root:root, mode 0600. Read by systemd, not
# by the service user.

# The export endpoint in the operator's tailnet.
UPSTREAM_URL=https://pvlogger-export.<tailnet>.ts.net/v1/export/latest
# 1Password "PVLogger Export Token", field token.
UPSTREAM_TOKEN=
# Single-use, pre-approved auth key for tag:pvlogger-relay. Leave it here after
# the first start: an empty TS_AUTHKEY makes the relay skip Tailscale and use
# the host network, where the endpoint is not reachable. A used single-use key
# cannot join anything else.
TS_AUTHKEY=
# Port his platform calls. 8080 is Tomcat's default; check `ss -ltn` first.
HTTP_PORT=8780
