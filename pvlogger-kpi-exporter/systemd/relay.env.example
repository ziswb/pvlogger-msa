# relay.env — fill in UPSTREAM_TOKEN and TS_AUTHKEY, then run install.sh.
# install.sh copies it to /etc/pvlogger-relay/relay.env (root:root, 0600) and
# deletes this copy. Read by systemd, not by the service user.
# Port and export directory are install.sh arguments (-p, -d), not set here.

# The export endpoint in the operator's tailnet.
UPSTREAM_URL=https://pvlogger-export.<tailnet>.ts.net/v1/export/latest
# 1Password "PVLogger Export Token", field token.
UPSTREAM_TOKEN=
# Single-use, pre-approved auth key for tag:pvlogger-relay, made just before.
# Leave it here after the first start: an empty TS_AUTHKEY makes the relay skip
# Tailscale and use the host network, where the endpoint is not reachable.
# A used single-use key cannot join anything else.
TS_AUTHKEY=
