#!/bin/sh
# Leak guard, layer 2 (see .githooks/README.md): pattern rules + private blocklist.
set -e
hooks_dir=$(dirname "$0")
. "$hooks_dir/lib.sh"

require_noreply_email pre-commit

if have_gitleaks pre-commit; then
  gitleaks git --pre-commit --staged --redact=100 --no-banner --config .gitleaks.toml
fi

python3 "$hooks_dir/blocklist-check.py" --staged
